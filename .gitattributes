# The scripts are hashed byte for byte by the code fingerprints and the text outputs are compared byte for byte by the
# reproduction check: keep LF line endings on every platform.
*.py text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.bib text eol=lf
Makefile text eol=lf
